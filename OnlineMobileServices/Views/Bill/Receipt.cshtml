@model OnlineMobileServices.Models.PostPaidBill

@{
    ViewData["Title"] = "Bill Receipt";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width:80px;height:80px;">
                        <i class="bi bi-check-circle-fill display-4 text-success"></i>
                    </div>
                    <h3 class="mt-3 fw-bold text-success">Bill Paid Successfully!</h3>
                    <p class="text-muted">Your postpaid bill has been paid</p>
                </div>

                <div class="bg-light rounded p-3 mb-3">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted">Transaction ID</td>
                                <td class="text-end"><code>@Model.TransactionId</code></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Mobile Number</td>
                                <td class="text-end">+91 @Model.MobileNumber</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Amount Paid</td>
                                <td class="text-end fw-bold text-primary fs-5">₹@Model.Amount</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Status</td>
                                <td class="text-end">
                                    <span class="badge bg-success">@Model.PaidStatus</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Payment Date</td>
                                <td class="text-end">@Model.PaymentDate?.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Due Date</td>
                                <td class="text-end">@Model.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Bill" asp-action="EnterMobile" class="btn btn-success">
                        <i class="bi bi-receipt"></i> Pay Another Bill
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-house"></i> Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
