@model OnlineMobileServices.Models.PostPaidBill

@{
    ViewData["Title"] = "Pay Bill";
    var isOverdue = Model.DueDate < DateTime.Now;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="page-header text-center">
            <h2><i class="bi bi-receipt"></i> Bill Payment</h2>
            <p>Review your bill details and proceed to pay</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="rounded-circle @(isOverdue ? "bg-danger" : "bg-warning") bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width:70px;height:70px;">
                        <i class="bi bi-receipt-cutoff display-6 @(isOverdue ? "text-danger" : "text-warning")"></i>
                    </div>
                    @if (isOverdue)
                    {
                        <div class="mt-2">
                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Overdue</span>
                        </div>
                    }
                </div>

                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <td class="fw-semibold text-muted">Mobile Number</td>
                            <td class="text-end fw-bold">+91 @Model.MobileNumber</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Bill Status</td>
                            <td class="text-end">
                                <span class="badge bg-warning text-dark">@Model.PaidStatus</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Due Date</td>
                            <td class="text-end @(isOverdue ? "text-danger fw-bold" : "")">
                                @Model.DueDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                        <tr class="border-top">
                            <td class="fw-bold fs-5">Bill Amount</td>
                            <td class="text-end fw-bold fs-4 text-primary">₹@Model.Amount</td>
                        </tr>
                    </tbody>
                </table>

                <form method="post" asp-action="PaymentConfirm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BillId" />

                    <button type="submit" class="btn btn-success w-100 py-2 btn-lg">
                        <i class="bi bi-wallet2"></i> Pay ₹@Model.Amount Now
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-action="EnterMobile" class="text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Change Number
                    </a>
                </div>
            </div>
        </div>

        <div class="card mt-3 shadow-sm border-0">
            <div class="card-body p-3 text-center">
                <small class="text-muted">
                    <i class="bi bi-shield-check text-success"></i> Secure payment | Instant confirmation
                </small>
            </div>
        </div>
    </div>
</div>
