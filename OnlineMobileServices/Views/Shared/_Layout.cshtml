@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
    var isLoggedIn = !string.IsNullOrEmpty(username);
    var isAdmin = userRole == "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineMobileServices</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        body {
            background-color: #f0f2f5;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background: var(--primary-gradient) !important;
            box-shadow: 0 2px 15px rgba(0,0,0,0.15);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        .navbar-brand i {
            margin-right: 8px;
        }

        .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            transition: all 0.3s ease;
            border-radius: 6px;
            margin: 0 2px;
        }

        .nav-link:hover {
            background-color: rgba(255,255,255,0.15);
        }

        .user-badge {
            background: rgba(255,255,255,0.2);
            padding: 5px 15px;
            border-radius: 20px;
            font-weight: 500;
        }

        main {
            flex: 1;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            transition: transform 0.2s ease;
        }

        .card:hover {
            transform: translateY(-2px);
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            padding: 8px 20px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
            box-shadow: 0 4px 15px rgba(102,126,234,0.4);
        }

        .page-header {
            background: var(--primary-gradient);
            color: white;
            padding: 2rem;
            border-radius: 12px;
            margin-bottom: 2rem;
        }

        .page-header h2 {
            margin-bottom: 0.3rem;
            font-weight: 700;
        }

        .page-header p {
            opacity: 0.9;
            margin-bottom: 0;
        }

        footer {
            margin-top: auto;
            background: #2d3436;
            color: #b2bec3;
        }

        footer a {
            color: #74b9ff;
            text-decoration: none;
        }

        footer a:hover {
            color: #a29bfe;
        }

        .table {
            border-radius: 8px;
            overflow: hidden;
        }

        .table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .table thead th {
            border: none;
            font-weight: 600;
            padding: 12px 16px;
        }

        .table tbody td {
            padding: 12px 16px;
            vertical-align: middle;
        }

        .badge-success { background-color: #00b894; }
        .badge-danger { background-color: #e17055; }
        .badge-warning { background-color: #fdcb6e; color: #2d3436; }
        .badge-info { background-color: #74b9ff; }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25);
        }

        .alert {
            border-radius: 10px;
            border: none;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-phone"></i>OnlineMobileServices
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu"
                        aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">

                    <!-- Left Menu -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        @if (isLoggedIn && !isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> My Dashboard
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recharge" asp-action="EnterMobile">
                                <i class="bi bi-lightning-charge"></i> Recharge
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Bill" asp-action="EnterMobile">
                                <i class="bi bi-receipt"></i> Bill Payment
                            </a>
                        </li>
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Feedback" asp-action="Create">
                                    <i class="bi bi-chat-dots"></i> Feedback
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock"></i> Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Manage Users</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ViewRecharges"><i class="bi bi-lightning-charge"></i> All Recharges</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ViewBills"><i class="bi bi-receipt"></i> All Bills</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ViewFeedback"><i class="bi bi-chat-dots"></i> All Feedback</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Right Menu -->
                    <ul class="navbar-nav">
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-badge">
                                        <i class="bi bi-person-circle"></i> @username
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (!isAdmin)
                                    {
                                        <li><a class="dropdown-item" asp-controller="User" asp-action="Profile"><i class="bi bi-person"></i> My Profile</a></li>
                                        <li><a class="dropdown-item" asp-controller="User" asp-action="RechargeHistory"><i class="bi bi-clock-history"></i> Recharge History</a></li>
                                        <li><a class="dropdown-item" asp-controller="User" asp-action="BillHistory"><i class="bi bi-journal-text"></i> Bill History</a></li>
                                        <li><a class="dropdown-item" asp-controller="User" asp-action="Services"><i class="bi bi-gear"></i> Services</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- Alerts -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Body -->
    <div class="container mt-2 mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h6 class="text-white"><i class="bi bi-phone"></i> OnlineMobileServices</h6>
                    <p class="small mb-0">Your one-stop solution for mobile recharges, bill payments, and value-added services.</p>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h6 class="text-white">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Recharge" asp-action="EnterMobile">Online Recharge</a></li>
                        <li><a asp-controller="Bill" asp-action="EnterMobile">Pay Bill</a></li>
                        <li><a asp-controller="Feedback" asp-action="Create">Feedback</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Contact</h6>
                    <ul class="list-unstyled small">
                        <li><i class="bi bi-envelope"></i> support@mobilesvc.com</li>
                        <li><i class="bi bi-telephone"></i> 1800-123-4567 (Toll Free)</li>
                        <li><i class="bi bi-geo-alt"></i> Mumbai, India</li>
                    </ul>
                </div>
            </div>
            <hr class="my-3" style="border-color: #636e72;" />
            <div class="text-center small">
                &copy; @DateTime.Now.Year OnlineMobileServices. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('.alert').forEach(function(alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>