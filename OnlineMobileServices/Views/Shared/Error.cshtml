@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center py-5">
        <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width:100px;height:100px;">
            <i class="bi bi-exclamation-triangle-fill display-3 text-danger"></i>
        </div>
        <h2 class="mt-4 fw-bold">Oops! Something went wrong</h2>
        <p class="text-muted">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-grid gap-2 col-6 mx-auto mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary py-2">
                <i class="bi bi-house"></i> Go to Home
            </a>
        </div>
    </div>
</div>
