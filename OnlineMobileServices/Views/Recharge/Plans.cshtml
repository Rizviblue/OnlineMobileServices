@model List<OnlineMobileServices.Models.RechargePlan>

@{
    ViewData["Title"] = "Recharge Plans";
    var mobile = ViewBag.Mobile as string;
    var type = ViewBag.Type as string;
}

<div class="page-header text-center">
    <h2><i class="bi bi-collection"></i> @type Plans</h2>
    <p>Mobile: <strong>+91 @mobile</strong> | Choose a plan that suits you</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No plans available</h4>
        <p class="text-muted">Please check back later or try a different category.</p>
        <a asp-action="SelectType" asp-route-mobile="@mobile" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Back to Types
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var plan in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">@plan.PlanName</h5>
                            <span class="badge bg-primary fs-6">₹@plan.Amount</span>
                        </div>
                        <p class="text-muted small flex-grow-1">@plan.Description</p>
                        <a asp-action="Payment" asp-route-planId="@plan.PlanId" asp-route-mobile="@mobile"
                           class="btn btn-primary w-100 mt-2">
                            <i class="bi bi-cart-check"></i> Select Plan
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4">
        <a asp-action="SelectType" asp-route-mobile="@mobile" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Recharge Type
        </a>
    </div>
}
