@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="page-header text-center">
            <h2><i class="bi bi-shield-check"></i> Privacy Policy</h2>
            <p>Your privacy is important to us</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold">1. Information We Collect</h5>
                <p class="text-muted">We collect your name, mobile number, email address, and transaction history to provide our recharge and bill payment services. All information is securely stored and encrypted.</p>

                <h5 class="fw-bold mt-4">2. How We Use Your Information</h5>
                <p class="text-muted">Your personal information is used to process recharges, bill payments, manage your account, and improve our services. We do not sell or share your data with third parties.</p>

                <h5 class="fw-bold mt-4">3. Data Security</h5>
                <p class="text-muted">We implement industry-standard security measures including password hashing, session management, and secure data transmission to protect your personal information.</p>

                <h5 class="fw-bold mt-4">4. Transaction Records</h5>
                <p class="text-muted">All transaction records including recharges and bill payments are stored securely for your reference and our operational needs. You can view your transaction history from your dashboard.</p>

                <h5 class="fw-bold mt-4">5. Cookies & Sessions</h5>
                <p class="text-muted">We use session cookies to maintain your login state. These cookies are essential for the application to function properly and expire when you log out or after 30 minutes of inactivity.</p>

                <h5 class="fw-bold mt-4">6. Contact Us</h5>
                <p class="text-muted mb-0">If you have any questions about this Privacy Policy, please contact us at <strong>support@mobilesvc.com</strong> or call <strong>1800-123-4567</strong> (Toll Free).</p>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Home
            </a>
        </div>
    </div>
</div>
