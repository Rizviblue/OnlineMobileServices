@model List<OnlineMobileServices.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h2><i class="bi bi-people"></i> Manage Users</h2>
            <p>View, edit, and manage all registered users</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No users found</h4>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">All Users (@Model.Count)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Registered</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sn = 1; }
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@(sn++)</td>
                                <td class="fw-semibold">@user.FullName</td>
                                <td>+91 @user.MobileNumber</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-primary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="small">@user.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <a asp-action="EditUser" asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (user.Role != "Admin")
                                    {
                                        <form method="post" asp-action="DeleteUser" asp-route-id="@user.UserId"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this user?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
