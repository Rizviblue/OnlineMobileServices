@model List<OnlineMobileServices.Models.Feedback>

@{
    ViewData["Title"] = "All Feedback";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h2><i class="bi bi-chat-dots"></i> All Feedback</h2>
            <p>Customer feedback and suggestions</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-light">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-chat-dots display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No feedback received yet</h4>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">All Feedback (@Model.Count)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sn = 1; }
                        @foreach (var f in Model)
                        {
                            <tr>
                                <td>@(sn++)</td>
                                <td class="fw-semibold">@f.Name</td>
                                <td>@f.MobileNumber</td>
                                <td style="max-width: 350px;">@f.Message</td>
                                <td class="small">@f.FeedbackDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="text-center">
                                    <form method="post" asp-action="DeleteFeedback" asp-route-id="@f.FeedbackId"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this feedback?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
