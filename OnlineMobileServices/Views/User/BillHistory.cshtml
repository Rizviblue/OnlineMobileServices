@model List<OnlineMobileServices.Models.PostPaidBill>

@{
    ViewData["Title"] = "Bill History";
}

<div class="page-header text-center">
    <h2><i class="bi bi-journal-text"></i> Bill Payment History</h2>
    <p>View all your past bill payments</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No bills found</h4>
        <p class="text-muted">You don't have any bill records yet.</p>
        <a asp-controller="Bill" asp-action="EnterMobile" class="btn btn-success">
            <i class="bi bi-receipt"></i> Pay a Bill
        </a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Mobile</th>
                            <th>Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Transaction ID</th>
                            <th>Payment Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sn = 1; }
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td>@(sn++)</td>
                                <td>+91 @b.MobileNumber</td>
                                <td class="fw-bold">?@b.Amount</td>
                                <td class="@(b.DueDate < DateTime.Now && b.PaidStatus == "Unpaid" ? "text-danger fw-bold" : "")">
                                    @b.DueDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge @(b.PaidStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                        @b.PaidStatus
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(b.TransactionId))
                                    {
                                        <code>@b.TransactionId</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (b.PaymentDate.HasValue)
                                    {
                                        @b.PaymentDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 text-muted small text-end">
        Total: <strong>@Model.Count</strong> bill(s) |
        Paid: <strong>?@Model.Where(b => b.PaidStatus == "Paid").Sum(b => b.Amount).ToString("N0")</strong> |
        Unpaid: <strong>?@Model.Where(b => b.PaidStatus == "Unpaid").Sum(b => b.Amount).ToString("N0")</strong>
    </div>
}

<div class="text-center mt-4">
    <a asp-controller="User" asp-action="Dashboard" class="btn btn-outline-secondary me-2">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
    <a asp-controller="Bill" asp-action="EnterMobile" class="btn btn-success">
        <i class="bi bi-receipt"></i> Pay a Bill
    </a>
</div>
