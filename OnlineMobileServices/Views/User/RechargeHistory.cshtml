@model List<OnlineMobileServices.Models.Recharge>

@{
    ViewData["Title"] = "Recharge History";
}

<div class="page-header text-center">
    <h2><i class="bi bi-clock-history"></i> Recharge History</h2>
    <p>View all your past recharges</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No recharges found</h4>
        <p class="text-muted">You haven't made any recharges yet.</p>
        <a asp-controller="Recharge" asp-action="EnterMobile" class="btn btn-primary">
            <i class="bi bi-lightning-charge"></i> Recharge Now
        </a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Plan</th>
                            <th>Amount</th>
                            <th>Transaction ID</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sn = 1; }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@(sn++)</td>
                                <td>@(r.RechargePlan?.PlanName ?? "N/A")</td>
                                <td class="fw-bold">?@r.Amount</td>
                                <td><code>@r.TransactionId</code></td>
                                <td>
                                    <span class="badge @(r.PaymentStatus == "Success" ? "bg-success" : "bg-danger")">
                                        @r.PaymentStatus
                                    </span>
                                </td>
                                <td>@r.RechargeDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 text-muted small text-end">
        Total: <strong>@Model.Count</strong> recharge(s) | Total Spent: <strong>?@Model.Sum(r => r.Amount).ToString("N0")</strong>
    </div>
}

<div class="text-center mt-4">
    <a asp-controller="User" asp-action="Dashboard" class="btn btn-outline-secondary me-2">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
    <a asp-controller="Recharge" asp-action="EnterMobile" class="btn btn-primary">
        <i class="bi bi-lightning-charge"></i> New Recharge
    </a>
</div>
