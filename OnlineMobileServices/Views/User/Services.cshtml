@model List<OnlineMobileServices.Models.Service>

@{
    ViewData["Title"] = "Services";
    var userServices = ViewBag.UserServices as List<int> ?? new List<int>();
}

<div class="page-header text-center">
    <h2><i class="bi bi-gear"></i> Value Added Services</h2>
    <p>Manage your services and activate new ones</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No services available</h4>
        <p class="text-muted">Check back later for new services.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var service in Model)
        {
            var isActive = userServices.Contains(service.ServiceId);
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm @(isActive ? "border-success border-2" : "")">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold">
                                <i class="bi bi-@(isActive ? "check-circle-fill text-success" : "circle text-muted") me-1"></i>
                                @service.ServiceName
                            </h5>
                            @if (isActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </div>
                        <p class="text-muted flex-grow-1">@service.Description</p>

                        @if (isActive)
                        {
                            <form method="post" asp-action="DeactivateService">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="serviceId" value="@service.ServiceId" />
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="bi bi-x-circle"></i> Deactivate
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-action="ActivateService">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="serviceId" value="@service.ServiceId" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus-circle"></i> Activate
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="text-center mt-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>
