@model OnlineMobileServices.Models.ViewModels.UserDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h2><i class="bi bi-speedometer2"></i> Welcome, @Model.User.FullName!</h2>
            <p>Mobile: +91 @Model.User.MobileNumber | Member since @Model.User.CreatedDate.ToString("MMM yyyy")</p>
        </div>
        <a asp-action="EditProfile" class="btn btn-light">
            <i class="bi bi-pencil"></i> Edit Profile
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="card-body">
                <i class="bi bi-lightning-charge-fill display-5 text-primary"></i>
                <h3 class="mt-2 fw-bold">@Model.TotalRecharges</h3>
                <p class="text-muted mb-0">Total Recharges</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="card-body">
                <i class="bi bi-receipt-cutoff display-5 text-success"></i>
                <h3 class="mt-2 fw-bold">@Model.TotalBillsPaid</h3>
                <p class="text-muted mb-0">Bills Paid</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center p-3">
            <div class="card-body">
                <i class="bi bi-wallet2 display-5 text-warning"></i>
                <h3 class="mt-2 fw-bold">₹@Model.TotalSpent.ToString("N0")</h3>
                <p class="text-muted mb-0">Total Spent</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-controller="Recharge" asp-action="EnterMobile" class="btn btn-primary w-100 py-3 text-start">
            <i class="bi bi-lightning-charge"></i> Recharge Now
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Bill" asp-action="EnterMobile" class="btn btn-success w-100 py-3 text-start">
            <i class="bi bi-receipt"></i> Pay Bill
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Services" class="btn btn-info text-white w-100 py-3 text-start">
            <i class="bi bi-gear"></i> My Services
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Feedback" asp-action="Create" class="btn btn-warning w-100 py-3 text-start">
            <i class="bi bi-chat-dots"></i> Feedback
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Recharges -->
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-lightning-charge text-primary"></i> Recent Recharges</h5>
                <a asp-action="RechargeHistory" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentRecharges.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecentRecharges)
                                {
                                    <tr>
                                        <td class="fw-bold">₹@r.Amount</td>
                                        <td><span class="badge bg-success">@r.PaymentStatus</span></td>
                                        <td class="small">@r.RechargeDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox display-6 text-muted"></i>
                        <p class="text-muted mt-2">No recharges yet</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Bills -->
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt text-success"></i> Recent Bills</h5>
                <a asp-action="BillHistory" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentBills.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Due Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.RecentBills)
                                {
                                    <tr>
                                        <td class="fw-bold">₹@b.Amount</td>
                                        <td>
                                            <span class="badge @(b.PaidStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">
                                                @b.PaidStatus
                                            </span>
                                        </td>
                                        <td class="small">@b.DueDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox display-6 text-muted"></i>
                        <p class="text-muted mt-2">No bills yet</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Active Services -->
@if (Model.ActiveServices.Any())
{
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold"><i class="bi bi-gear text-info"></i> Active Services</h5>
        </div>
        <div class="card-body">
            <div class="row g-2">
                @foreach (var us in Model.ActiveServices)
                {
                    <div class="col-md-4">
                        <div class="border rounded p-3 d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <div>
                                <strong>@us.Service?.ServiceName</strong>
                                <br /><small class="text-muted">Active</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
